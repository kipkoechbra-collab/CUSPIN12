# Environment Variables - Chardon Holiday Market
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/chardon_market?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/chardon_market"

# ─── Authentication ─────────────────────────────────────────────────
JWT_SECRET="your-secure-jwt-secret-at-least-32-characters"
JWT_REFRESH_SECRET="your-secure-refresh-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:3001"

# ─── Email (SMTP) ──────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Chardon Holiday Market <noreply@chardonholidaymarket.com>"

# ─── Payment (Stripe) ──────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── File Upload ────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# ─── Admin Setup ────────────────────────────────────────────────────
ADMIN_SETUP_KEY="your-secure-setup-key-for-initial-admin"
